# Streamlit secrets template.
# Copy to `.streamlit/secrets.toml` (gitignored) to override defaults or to
# deploy on Streamlit Community Cloud with a service account.
#
# Local runs do NOT need this file: the dashboard uses Application Default
# Credentials (`gcloud auth application-default login`) and falls back to the
# committed CSVs in results/tables when BigQuery is unavailable.

# Optional: override the GCP project.
# gcp_project_id = "olist-analysis-project-495210"

# For Community Cloud: paste a service account key (BigQuery Data Viewer +
# Job User roles). On the local machine, prefer ADC instead of this block.
# [gcp_service_account]
# type = "service_account"
# project_id = "olist-analysis-project-495210"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@olist-analysis-project-495210.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
